name: someblackmagic/incus-ext
version: 1.0.0
description: Salt Extension for interacting with Incus containers and virtual machines

# --- Salt compatibility ---
minimum_version: "3006"
maximum_version: ~

python_requires: []

dependencies: []


conflicts: []

maintainers:
  - name: SomeBlackMagic
    email: dev@someblackmagic.com
    github: SomeBlackMagic


authors:
